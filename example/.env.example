# Optional host HTTP port for Docker Compose.
# Integer from 1024 to 65535; choose an available port. Default: 8080.
# An exported shell PORT overrides .env; an empty effective value uses 8080.
# Changes apply after rerunning docker compose up --build --wait.
# This changes neither website content nor local-file mode. No secrets needed.
PORT=8080

# Copy to .env in this folder to customize. Do not commit .env.
